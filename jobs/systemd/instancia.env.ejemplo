# Plantilla de /etc/mft/<instancia>.env  (instancias: dev, prod)
# Copiar a /etc/mft/dev.env, completar y dejar con: chown root:mft + chmod 640. NUNCA subir el archivo real al repo.
# Importante: systemd NO soporta comentarios al final de una línea (se tomarían como parte del valor).

# --- API ---
# Clave compartida con el backend (RECO_API_KEY de Tomcat). Generar con: openssl rand -hex 32
RECO_API_KEY=CAMBIAR
# IP interna de ESTA VM (hostname -I). Solo esa interfaz escucha; no usar 0.0.0.0.
RECO_HOST=10.0.0.0
# dev = 8001, prod = 8000
RECO_PORT=8001
# dev = 1, prod = 2
RECO_WORKERS=1
RECO_MODEL_PATH=/var/lib/mft/dev/models/current/modelo.joblib

# --- Job nocturno ---
# dev = gs://training_snapshots_dev ; prod = gs://training_snapshots (si usás una subcarpeta, agregarla al final)
RECO_ORIGEN=gs://training_snapshots_dev
RECO_BASE=/var/lib/mft/dev
