[Unit]
Description=MercadoFT recomendador - API
After=network.target

[Service]
User=mft
WorkingDirectory=/opt/mercadoft-recomendador
Environment=RECO_MODEL_PATH=/var/lib/mft/models/current/modelo.joblib
# RECO_API_KEY va en un archivo con permisos 600 fuera del repo:
EnvironmentFile=/etc/mft/api.env
ExecStart=/opt/mercadoft-recomendador/.venv/bin/uvicorn mft.api:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
